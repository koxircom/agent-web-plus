            "--test-concurrency=1",
            "--experimental-strip-types",
            "--test",
            "lib/session-deletion-audit.test.mjs",
            "lib/session-deletion-audit.integration.test.mjs"
          ],
          "files": [
            "lib/session-deletion-audit.test.mjs",
            "lib/session-deletion-audit.integration.test.mjs"
          ],
          "timeoutSeconds": 180
        },
        {
          "name": "release-quality-runner-integrity",
          "command": [
            "python3",
            "scripts/qa/test_integrity.py"
          ],
          "files": [
            "scripts/qa/test_integrity.py"
          ],
          "timeoutSeconds": 180
        },
        {
          "name": "release-react-user-message-identity",
          "command": [
            "node",
            "tests/user-message-identity.pw.mjs"
          ],
          "files": [
            "tests/user-message-identity.pw.mjs"
          ],
          "timeoutSeconds": 240
        },
        {
          "name": "release-browser-session-search-stale",
          "command": [
            "node",
            "tests/session-search-stale.pw.mjs"
          ],
          "files": [
            "tests/session-search-stale.pw.mjs"
          ],
          "timeoutSeconds": 240
        },
        {
          "name": "release-typescript",
          "command": [
            "node",
            "node_modules/typescript/bin/tsc",
            "--noEmit"
          ],
          "files": [
            "tsconfig.json",
            "package.json",
            "package-lock.json"
          ],
          "timeoutSeconds": 300
        },
        {
          "name": "browser-session-resilience",
          "command": [
            "node",
            "tests/session-resilience.pw.mjs"
          ],
          "files": [
            "tests/session-resilience.pw.mjs"
          ],
          "timeoutSeconds": 180
        },
        {
          "name": "model-thinking-core",
          "command": [
            "node",
            "--test-concurrency=1",
            "--experimental-strip-types",
            "--test",
            "lib/model-thinking-level.test.mjs",
            "lib/next-turn-settings.test.mjs",
            "lib/rpc-manager.test.mjs"
          ],
          "files": [
            "lib/model-thinking-level.test.mjs",
            "lib/next-turn-settings.test.mjs",
            "lib/rpc-manager.test.mjs"
          ],
          "timeoutSeconds": 180
        },
        {
          "name": "browser-model-thinking-switch",
          "command": [
            "node",
            "tests/model-thinking-switch.pw.mjs"
          ],
          "files": [
            "tests/model-thinking-switch.pw.mjs"
          ],
          "timeoutSeconds": 180
        }
      ]
    }
  }
}
