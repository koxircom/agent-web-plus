{
  "name": "@agegr/pi-web",
  "version": "1.4.9",
  "capabilities": {
    "nativeSettingsHost": true,
    "nativeSettingsLayout": true,
    "nativeBranding": true,
    "nativeComposerLayout": true,
    "nativeComposerPreferences": true,
    "nativeAskUser": true,
    "nativeSessionTags": true,
    "nativeUserMessageIdentity": true,
    "codexExecutionEngine": true
  },
  "piWebEdition": "koxir-standalone",
  "standalone": true,
  "description": "Agent Web Plus — Pi Agent 与 Codex 共用的浏览器工作台",
  "homepage": "https://github.com/koxircom/agent-web-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koxircom/agent-web-plus.git"
  },
  "bugs": {
    "url": "https://github.com/koxircom/agent-web-plus/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-web": "bin/pi-web.js",
    "agent-web": "bin/agent-web.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "next.config.ts",
    "package.json",
    "THIRD_PARTY_NOTICES.md",
    "!public/pi-*-manifest.json",
    "!public/pi-usage-ledger.json",
    "!public/*.before-*",
    "!public/**/*.test.mjs",
    "connectors/codex-bridge",
    "docs/codex-engine.md",
    "!connectors/**/__pycache__",
    "!connectors/**/*.pyc",
    "docs/agent-web-compatibility.md"
  ],
  "scripts": {
    "prebuild": "node scripts/check-sdk-baseline.cjs && node enhancements/build-pi-web-enhancements.cjs --build --verify && node scripts/build-session-history-worker.cjs",
    "prepack": "python3 scripts/check-publication.py --root . && node enhancements/build-pi-web-enhancements.cjs --verify && node scripts/check-client-budget.cjs && node scripts/build-session-history-worker.cjs && node scripts/qa/release-gate.cjs",
    "postinstall": "node bin/prepare-terminal.js",
    "dev": "next dev -H 127.0.0.1 -p 30141",
    "dev:lan": "next dev -H 0.0.0.0 -p 30141",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 30141",
    "start:lan": "next start -H 0.0.0.0 -p 30141",
    "lint": "eslint .",
    "test:terminal": "node e2e/terminal.mjs",
    "test:e2e": "node e2e/run.mjs",
    "test": "node --experimental-strip-types --test \"app/**/*.test.mjs\" \"components/**/*.test.mjs\" \"hooks/**/*.test.mjs\" \"lib/**/*.test.mjs\" \"public/**/*.test.mjs\"",
    "release": "npm run build && npm pack",
    "postbuild": "node scripts/check-client-budget.cjs",
    "qa:list": "node scripts/qa/release-gate.cjs --list",
    "qa:release": "node scripts/qa/release-gate.cjs",
    "check:publication": "python3 scripts/check-publication.py --root .",
    "release:publish": "python3 scripts/publish-release.py"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "5.4.2",
    "next": "16.3.6",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semver": "7.8.5",
    "undici": "8.11.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/semver": "7.8.0",
    "@types/web-push": "^3.6.4",
    "ansi_up": "^6.0.6",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jiti": "^2.7.0",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.2",
    "ios_saf 16.2"
  ]
}
