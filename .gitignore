# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.agents/
/skills-lock.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs

# Private agent/runtime data and release acceptance artifacts
**/__pycache__/
*.pyc
*.tgz
*.log
/runtime/
/acceptance/
/.codex/
/.pi/
/sessions/
/state/
/auth.json
/config.toml
/execution-engines.json
/connector.json
/public/pi-*-manifest.json
/public/pi-usage-ledger.json
/public/*.before-*
