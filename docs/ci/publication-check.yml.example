name: 发布脱敏关卡
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  publication:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - name: Check scanner behavior
        run: python3 -m unittest discover -s scripts -p test_check_publication.py -v
      - name: Check attachment upload gate
        run: python3 -m unittest discover -s scripts -p test_publish_release.py -v
      - name: Inspect public source
        run: python3 scripts/check-publication.py --root .
